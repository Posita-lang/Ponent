{
    "data_layout": "e-m:e-p:64:64:64-i64:64:64-f64:64:64-n8:16:32:64",
    "pointer_width": 64,
    "arch": "riscv64",
    "os": "linux",
    "abi": "lp64d",
    "endian": "little",
    "int_sizes": { "8": 1, "16": 2, "32": 4, "64": 8 },
    "float_sizes": { "32": 4, "64": 8 },
    "default_overflow": "trap",
    "max_align": 16,
    "allow_unaligned": true,
    "packed_default": false,
    "atomic_bits": [8, 16, 32, 64],
    "stack_align": 16,
    "fn_align": 16,
    "global_align": 16,
    "forbid_panic": false,
    "deterministic_memory": false,
    "description": "RISC-V 64-bit (Linux, LP64D ABI with double-precision float)"
}
